
{
  "name": "lumen-log",
  "version": "0.1.0",
  "description": "A customizable logger for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --out-dir dist && tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "logger",
    "logging",
    "nodejs",
    "typescript",
    "console",
    "lumen-log"
  ],
  "author": "ButkovKirill",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
